@model CreateCategoryVM

<h2 class="text-center">Додавання категорії</h2>
<div class="d-flex justify-content-center w-50 m-auto">
    <form class="w-100 text-center bg-body-tertiary py-2 px-4"
          method="post"
          asp-controller="Category"
          asp-action="Create">
        <div>
            <label for="name" class="form-label mt-2">Назва</label>
            <input type="text" class="form-control" id="name" name="name" asp-for="Name" />
            <div class="text-start ms-2" style="min-height: 24px;">
                <span class="text-danger" style="font-size: 12px;" asp-validation-for="Name"></span>
            </div>
        </div>
        <div>
            <button type="button" class="btn btn-primary w-100" data-bs-toggle="modal" data-bs-target="#iconsModal">
                Обрати іконку
            </button>
            <div class="modal fade" id="iconsModal" tabindex="-1" role="dialog" aria-labelledby="iconsModalLabel" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="iconsModalLabel">Modal title</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            ...
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                            <button type="button" class="btn btn-primary">Save changes</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-center mt-3">
            <input class="btn btn-success w-25" type="submit" value="Додати">
            <a class="btn btn-dark w-25" asp-controller="Category" asp-action="Index">Назад</a>
        </div>
    </form>
</div>